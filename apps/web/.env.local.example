# Local DEVELOPMENT ONLY. Copy this file to `.env.local` (which git ignores) and choose your own password; `next dev` loads it.
# Sign in at http://localhost:3000 with the super user below, then create staff users under Users & roles.
# Never reuse a password from here anywhere real, and never commit the copy.
MERIDIAN_SUPERUSER_USERNAME=admin
MERIDIAN_SUPERUSER_PASSWORD=choose-your-own-12-plus-characters
