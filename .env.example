# PostgreSQL / AlloyDB connection. If unset, an embedded Postgres (PGlite) is used: zero setup, in-memory.
# DATABASE_URL=postgres://meridian:meridian@localhost:5432/meridian

# Persist the embedded database to disk (ignored when DATABASE_URL is set).
# MERIDIAN_DATA_DIR=./.data

# none | reference (catalog + stock only) | demo (reference + sample customers, orders, invoices)
# Default: demo on the embedded database, reference on DATABASE_URL.
# MERIDIAN_SEED=reference

# Number of logical shards. The dev partitions migration creates 16 (0..15); production uses 1024.
# MERIDIAN_LOGICAL_SHARDS=16

# Secret used to hash ID documents for duplicate detection. REQUIRED in production.
# MERIDIAN_ID_PEPPER=change-me

# SAP company code written to the GL export.
# MERIDIAN_SAP_COMPANY_CODE=1000
