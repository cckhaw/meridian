# ── Required in production (the app refuses to serve traffic without these) ─────────────────────────────
# PostgreSQL / AlloyDB connection string (pooled endpoint is fine; use sslmode=require).
DATABASE_URL=postgres://user:password@host:5432/meridian?sslmode=require

# Super user: the break-glass account that creates everyone else. Lives ONLY in the environment.
# Password: 12+ characters, not a common password. Changing either value signs the super user out everywhere.
MERIDIAN_SUPERUSER_USERNAME=
MERIDIAN_SUPERUSER_PASSWORD=

# Secret (16+ characters) used to hash customer ID documents for duplicate detection. Never change it once customers exist.
MERIDIAN_ID_PEPPER=

# ── Payments ────────────────────────────────────────────────────────────────────────────────────────────
# manual (default in production): staff record payments with a terminal approval/receipt number.
# simulated (default in development): a fake gateway auto-approves cards. Never use in production.
# MERIDIAN_PAYMENT_MODE=manual
# Enables POST /api/webhooks/payment (HMAC-SHA256 signed). 16+ characters. Unset = endpoint disabled.
# MERIDIAN_PAYMENT_WEBHOOK_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────────────────────────────────
# none (default in production) | starter (sample catalog + stock) | demo (starter + fake customers; development only)
# MERIDIAN_SEED=none
# Sessions
# MERIDIAN_SESSION_IDLE_MINUTES=30
# MERIDIAN_SESSION_MAX_HOURS=12
# Sign-in protection
# MERIDIAN_LOCK_AFTER_FAILURES=5
# MERIDIAN_LOCK_MINUTES=15
# MERIDIAN_LOGIN_IP_LIMIT=30
# MERIDIAN_LOGIN_USER_LIMIT=10
# SAP company code written to the GL export.
# MERIDIAN_SAP_COMPANY_CODE=1000
# Logical shards. The migration creates partitions for 0-15 (development size); see docs/OPERATIONS.md before raising it.
# MERIDIAN_LOGICAL_SHARDS=16
# Connection pool size per server instance (use 1-3 on serverless).
# PG_POOL_MAX=3
# Local development only: persist the embedded database to disk instead of memory (ignored when DATABASE_URL is set).
# MERIDIAN_DATA_DIR=./.data
